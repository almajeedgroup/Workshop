{
  "name": "almajeed-workshops",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Workshop records for Al-Majeed School of Research Methodology & Innovation",
  "scripts": {
    "dev": "vite",
    "test": "node --test \"tests/**/*.test.js\"",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && firebase deploy",
    "harness": "vite --config tools/harness/vite.config.js",
    "print-audit": "node tools/print-audit.mjs",
    "motion-audit": "node tools/motion-audit.mjs",
    "emulator": "npx --yes --package firebase-tools firebase emulators:start --only firestore,auth --project demo-workshop --config tools/emulator.firebase.json",
    "rules-audit": "node tools/rules-audit.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "firebase": "^11.1.0",
    "gsap": "^3.15.0",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.63.0",
    "vite": "^6.0.7"
  }
}
