rules_version = '2';

// Al-Majeed Workshops — access model
// ----------------------------------
// Firebase's Email/Password provider lets ANYONE who has the (public) web API
// key create an account. So "signed in" is NOT proof of authorisation.
//
// Authorisation is the /admins allow-list, and nothing else:
//
//     a request may read or write data  <=>  /admins/{request.auth.uid} exists
//
// The permanent owner address gets ONE privilege, and it is not data access:
// it may create its own /admins record. That is what makes the very first
// sign-in work without anyone hand-creating a document in the Console. The
// owner is then an administrator by the same rule as everybody else.
//
// This matters: an impostor who claimed the owner address before it was
// registered used to gain silent read access to every student's phone number
// and date of birth. Now they must first write a document into /admins, which
// is visible in the Console and in the audit log. Registering the address is
// still the real protection — see below.
//
// To authorise anyone else:
//   1. Firebase Console > Authentication > Users > Add user (email + password)
//   2. Copy their UID
//   3. Firestore > collection "admins" > document ID = that UID
//      (fields: email, name)
// To revoke: delete their /admins/{uid} document. This works for the owner
// too, though they can re-create their own record by signing in again — to
// remove them for good, delete the account in Authentication as well.
//
// KEEP THE EMAIL BELOW IN SYNC with BOOTSTRAP_ADMIN_EMAIL in
// src/lib/schema.js. Rules cannot import from JavaScript, so it lives in
// both files; the copy here is the one that is actually enforced.
//
// NOTE ON email_verified: it is deliberately NOT required. Accounts created
// from the Firebase Console are unverified, which is exactly how every
// account here is made, so requiring it would lock out all of them.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    /**
     * A student who has claimed a ticket for THIS course.
     *
     * The one thing in this file that grants a signed-in account who is not
     * an administrator the right to read something. It grants exactly one
     * collection on one course — the library — and it is a path lookup, not
     * a query, because rules cannot run queries.
     *
     * Note what it deliberately is NOT: `request.auth != null`. Anybody
     * holding the public API key can create an account, so "signed in" is
     * not a permission anywhere in this file and must never become one.
     */
    function isMember(workshopId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/workshops/$(workshopId)/members/$(request.auth.uid));
    }

    // Holder of the permanent owner address. Grants no data access on its
    // own — only the right to join the allow-list above.
    function isBootstrapOwner() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'almajeed.work@gmail.com';
    }

    function sized(value, max) {
      return value is string && value.size() <= max;
    }

    // Light-touch shape checks. Deliberately NOT a full field list: the app
    // generates its fields from src/lib/schema.js, and mirroring that here
    // would mean editing two files every time one is added. These bound what
    // a stolen administrator session can store, without freezing the schema.
    function sane(data, longestField) {
      return data.keys().size() <= 40
        && sized(data.get('searchText', ''), 8000)
        && sized(data.get(longestField, ''), 300);
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if isBootstrapOwner()
                    && request.auth.uid == uid
                    && request.resource.data.email.lower() == request.auth.token.email.lower();
      allow update: if isBootstrapOwner() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /workshops/{workshopId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && sane(request.resource.data, 'title');

      match /registrations/{registrationId} {
        allow read, delete: if isAdmin();
        allow create, update: if isAdmin() && sane(request.resource.data, 'name');
      }

      // The attendance register: one document per day, holding a map of
      // registration ID to mark.
      //
      // Administrator-only, like the registrations it refers to. The map is
      // not shape-checked field by field — the keys are registration IDs and
      // there is no fixed set of them — but the document is capped so a
      // stolen session cannot store a book in it, and `hasOnly` keeps
      // anything but `marks` out.
      match /attendance/{day} {
        allow read, delete: if isAdmin();
        allow create, update: if isAdmin()
          && request.resource.data.keys().hasOnly(['marks'])
          && request.resource.data.marks is map
          && request.resource.data.marks.keys().size() <= 2000;

        // A student marking themselves present, from the class link.
        //
        // The document's ID is their TICKET NUMBER, which is the whole
        // reason this can be allowed at all: one document per ticket per
        // day, addressed by path, so the rule can say exactly what may
        // happen to it. CREATE ONLY — no update and no delete — so a
        // student cannot change their own entry, cannot remove anybody
        // else's, and cannot touch the `marks` map above, which stays the
        // office's alone. An explicit mark therefore always wins.
        //
        // Joining twice is not an error: the second create simply fails,
        // and the client ignores it.
        //
        // WHAT THIS DOES NOT PROVE. It does not prove the person holding
        // the link is the ticket-holder. Ticket numbers run in sequence,
        // so somebody with the class link who knows one can record it as
        // present. Without a server there is no way to do better: the
        // browser cannot be trusted and registrations are, correctly,
        // unreadable to it. What the shape does give is provenance — a
        // join is never mistaken for a mark the office made — so the
        // register shows where each came from and can be corrected.
        match /joins/{ticketId} {
          allow read, update, delete: if isAdmin();
          allow create: if classIsOpen(workshopId)
            && day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
            && ticketId.size() >= 3 && ticketId.size() <= 40
            && request.resource.data.keys().hasOnly(['at'])
            && request.resource.data.at == request.time;
        }
      }

      // Participant photographs for ID cards, kept apart from the
      // registration itself.
      //
      // Two reasons, and both matter. A photo is 20-60KB, and the workshop
      // screen reads every registration each time it opens — carrying them
      // on the record would mean a course of forty pulling megabytes down
      // before the table appeared. And a face is the most personal thing in
      // this database: its own collection is what lets the rule here stay
      // administrator-only while certificates next door are world-readable.
      //
      // The document holds ONE field. `hasOnly` is right here in a way it
      // would not be for workshops: there is no schema to freeze, and an
      // unexpected key is a good reason to refuse the write.
      match /registrationPhotos/{registrationId} {
        allow read, delete: if isAdmin();
        allow create, update: if isAdmin()
          && request.resource.data.keys().hasOnly(['photo'])
          && request.resource.data.photo is string
          && request.resource.data.photo.size() <= 400000;
      }

      // ---- What an online class leaves behind ------------------------
      //
      // Notes, a transcript and handouts, all written by the presenter and
      // READ BY STUDENTS WHO HAVE NO ACCOUNT. That is the only reason these
      // are not simply administrator-only like everything else under a
      // workshop, and it is why the read is conditional rather than open:
      // `classIsOpen` asks the public mirror, which is the same switch that
      // publishes the meeting room. Closing a class closes its notes with
      // it, and a course that never met online exposes nothing at all.
      //
      // None of these hold anything personal. They are what was said and
      // shown in a class the reader was invited to.
      match /classNotes/{day} {
        allow read: if isAdmin() || classIsOpen(workshopId);
        allow delete: if isAdmin();
        allow create, update: if isAdmin()
          && request.resource.data.keys().hasOnly(['text', 'updatedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 100000;
      }

      // One document per day rather than one per line: a class produces a
      // line every few seconds, and a document each would be thousands of
      // writes and thousands of reads for anybody following along.
      match /classTranscript/{day} {
        allow read: if isAdmin() || classIsOpen(workshopId);
        allow delete: if isAdmin();
        allow create, update: if isAdmin()
          && request.resource.data.keys().hasOnly(['lines', 'updatedAt'])
          && request.resource.data.lines is list
          && request.resource.data.lines.size() <= 5000;
      }

      // A link, or a PDF small enough to live in the record. There is no
      // file store behind this app, so `data` is capped well under the 1 MiB
      // document ceiling and anything bigger is shared as a link.
      // ---- Questions, the one thing a STUDENT writes -----------------
      //
      // Everything else under a class is written by the presenter and read by
      // the room. This goes the other way, so it is shaped like the
      // registration form — the only other place a stranger can write here.
      //
      // The class has to be OPEN. That is the same switch that publishes the
      // room, so a closed class takes the queue with it and a course that
      // never met online can never be posted to at all.
      //
      // `hasOnly` freezes the shape because there is no schema to grow here,
      // and an unexpected key is a good reason to refuse. The state is
      // checked by value, not measured: a stranger writes it, and only the
      // presenter may say something has been answered.
      match /classQuestions/{questionId} {
        allow read: if isAdmin() || classIsOpen(workshopId);
        allow delete: if isAdmin();
        // Marking one answered is the presenter's job, and theirs alone.
        allow update: if isAdmin();
        allow create: if classIsOpen(workshopId)
          && request.resource.data.keys().hasOnly(['name', 'text', 'state', 'hp', 'askedAt', 'at'])
          && request.resource.data.keys().hasAll(['name', 'text', 'state', 'hp'])
          && request.resource.data.state == 'open'
          && request.resource.data.hp == ''
          && sized(request.resource.data.name, 80)
          && request.resource.data.name.size() > 0
          && sized(request.resource.data.text, 300)
          && request.resource.data.text.size() > 0
          && sized(request.resource.data.get('askedAt', ''), 40);
      }

      // ---- The course library, and who may open it ------------------
      //
      // Everything under a class is live and then gone: the room closes and
      // the notes and transcript close with it. The library is the opposite
      // — a permanent shelf of recordings and handouts, put there by the
      // office and readable after the course by the people who took it.
      //
      // It holds NOTHING PERSONAL. What is on the shelf is what was said
      // and shown in a class, which is the same category as the transcript.
      // That is what makes it safe to hand to a student at all.
      //
      // `source` decides which of `url` and `path` is meaningful, and both
      // keys are always present so this list can be fixed. `addedAt` is the
      // server's, never the client's.
      match /library/{itemId} {
        allow read: if isAdmin() || isMember(workshopId);
        allow delete: if isAdmin();
        allow create, update: if isAdmin()
          && request.resource.data.keys().hasOnly(
               ['title', 'kind', 'source', 'url', 'path', 'text',
                'format', 'bytes', 'day', 'addedAt'])
          && request.resource.data.kind in ['recording', 'notes']
          // `text` is the third source: the notes a presenter typed during a
          // class, kept as words rather than made into a file nobody asked
          // to download or a link back to a class that has closed.
          && request.resource.data.source in ['link', 'file', 'text']
          && sized(request.resource.data.title, 200)
          && request.resource.data.title.size() > 0
          && sized(request.resource.data.url, 2000)
          && sized(request.resource.data.path, 500)
          && sized(request.resource.data.text, 100000)
          && sized(request.resource.data.format, 20)
          && sized(request.resource.data.day, 10)
          && request.resource.data.bytes is int
          && request.resource.data.bytes >= 0;
      }

      // Which tickets this course issued. The document IS its ticket, and
      // holds nothing else — the name and number that ticket belongs to
      // stay in `registrations`, which no student can read.
      //
      // Written by the office, read by NOBODY. A rule's `exists()` does not
      // need the caller to hold read permission, so this can answer "was
      // this ticket ever issued?" while staying shut to every client.
      match /tickets/{ticketId} {
        allow read, write: if isAdmin();
      }

      // The lock. One document per ticket, holding the account that claimed
      // it, and CREATE ONLY — so the first claim wins and every later one is
      // refused. That is what makes a ticket exclusive: a student whose
      // ticket has been taken finds out, rather than quietly sharing it.
      //
      // The claimant must name THEMSELVES. Without that, one account could
      // burn every ticket on a course by claiming them all for somebody
      // else and lock the whole cohort out.
      match /claims/{ticketId} {
        allow read, update, delete: if isAdmin();
        allow create: if request.auth != null
          && exists(/databases/$(database)/documents/workshops/$(workshopId)/tickets/$(ticketId))
          && request.resource.data.keys().hasOnly(['uid', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.at == request.time;
      }

      // The membership the library rule above reads.
      //
      // Allowed ONLY once the lock exists and names this account. That is
      // why claiming is three sequential writes and not one batch: rules see
      // a batch against the state before it, so a `members` write in the
      // same batch as its own claim could never satisfy this line.
      //
      // A student may re-write their own membership — the claim still has
      // to be theirs — so a claim that failed halfway can be finished by
      // trying again. They may read their own and nobody else's; the office
      // reads them all, because it is the office that revokes one.
      match /members/{uid} {
        allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
        allow delete: if isAdmin();
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['ticketId', 'name', 'email', 'at'])
          && exists(/databases/$(database)/documents/workshops/$(workshopId)/claims/$(request.resource.data.ticketId))
          && get(/databases/$(database)/documents/workshops/$(workshopId)/claims/$(request.resource.data.ticketId)).data.uid == request.auth.uid
          && sized(request.resource.data.ticketId, 40)
          && sized(request.resource.data.name, 120)
          && sized(request.resource.data.email, 200)
          && request.resource.data.at == request.time;
      }

      match /classHandouts/{handoutId} {
        allow read: if isAdmin() || classIsOpen(workshopId);
        allow delete: if isAdmin();
        allow create, update: if isAdmin()
          && request.resource.data.keys().hasOnly(['title', 'kind', 'url', 'data', 'bytes', 'addedAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200
          && request.resource.data.url is string
          && request.resource.data.url.size() <= 2000
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 900000;
      }
    }

    // ---- Certificates -------------------------------------------------
    //
    // These are the one thing in this database the public may read, and only
    // one document at a time, by its exact ID. That is what makes an employer
    // or a college able to check a certificate somebody shows them.
    //
    // A certificate carries a name, an award, a workshop and a date — and
    // nothing else. No phone number, no date of birth, no email, no address.
    // src/lib/certdb.js builds the record from a whitelist so a field added to
    // registrations later cannot leak out here.
    //
    // `list` is admin-only: reading one certificate you were given the ID for
    // is verification, enumerating the whole register is not.
    match /certificates/{certificateId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin() && sane(request.resource.data, 'recipientName');
      allow delete: if isAdmin();
    }

    // A holder's history, keyed by an unguessable random ID that appears only
    // on their own certificates. Public get, so someone verifying a
    // certificate can see what else that person was awarded; not listable, so
    // the set of holders cannot be walked.
    match /holders/{holderKey} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin() && sane(request.resource.data, 'name');
    }

    // The map from a phone number or email to a holderKey. Never public: it is
    // what would otherwise turn a certificate ID back into a contact detail.
    match /holderIndex/{identity} {
      allow read, write: if isAdmin();
    }

    // ---- Public registration ------------------------------------------
    //
    // A whitelisted mirror of the workshop: what a poster would say, and
    // nothing else. The workshop document itself carries internal notes and
    // counters, and Firestore rules cannot expose half a document — hence a
    // separate one. src/lib/publicdb.js builds it from a whitelist.
    // ---- A student's own list of courses --------------------------------
    //
    // "Which courses am I in" is a question no rule can answer and no
    // reasonable query can either: membership lives under each workshop, and
    // a collection-group search would need its own index and its own rule
    // for a handful of documents. So the student keeps their own list.
    //
    // THIS GRANTS NOTHING. Writing a row here does not open a library — the
    // library is gated by `members`, which is gated by the claim, which is
    // gated by the ticket index. A student who forged a row here would get
    // a dashboard entry that refuses to open, which is the correct failure.
    //
    // The office can read and delete, because revoking has to clear the
    // student's list too or their dashboard keeps offering a course it can
    // no longer open.
    match /students/{uid}/courses/{workshopId} {
      allow read, delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ticketId', 'at'])
        && sized(request.resource.data.ticketId, 40)
        && request.resource.data.at == request.time;
    }

    match /publicWorkshops/{workshopId} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Registration requests are the ONE place an unauthenticated stranger may
    // write, so this is the strictest rule in the file.
    //
    //   - create only. No read, no list, no update, no delete — not even by
    //     the person who submitted it. A submission cannot be read back, so
    //     the form cannot be turned into a way of reading other people's.
    //   - the key set is fixed. Unlike the admin collections, where a
    //     whitelist would freeze the schema, here an unexpected field is a
    //     good reason to refuse the write.
    //   - the workshop must exist AND have registration open, so a closed or
    //     deleted workshop cannot collect entries.
    //   - `hp` is a honeypot: hidden from people, filled in by naive bots.
    //     It must arrive empty.
    //
    // Rules cannot rate-limit. If the form is ever abused, close registration
    // on the workshop and the writes stop at the door.
    function requestFields() {
      return ['workshopId', 'name', 'dob', 'qualification', 'courseName',
              'whatsapp', 'area', 'email', 'attendMode', 'paymentMode',
              'paymentRef', 'notes', 'ref', 'status', 'hp', 'createdAt'];
    }

    // `get` on a path that does not exist raises an evaluation error rather
    // than returning nothing, and a mirror written before this field existed
    // has no `registrationOpen` at all — so both are handled explicitly. The
    // request is refused either way; this just refuses it cleanly.
    function openForRegistration(workshopId) {
      return exists(/databases/$(database)/documents/publicWorkshops/$(workshopId))
        && get(/databases/$(database)/documents/publicWorkshops/$(workshopId))
             .data.get('registrationOpen', false) == true;
    }

    // The same switch that publishes the meeting room. Written like
    // `openForRegistration` above and for the same reason: `get` on a path
    // that does not exist raises rather than returning nothing, and a mirror
    // written before this field existed has no `classOpen` at all.
    function classIsOpen(workshopId) {
      return exists(/databases/$(database)/documents/publicWorkshops/$(workshopId))
        && get(/databases/$(database)/documents/publicWorkshops/$(workshopId))
             .data.get('classOpen', false) == true;
    }

    function validRequest(d) {
      return d.keys().hasAll(['workshopId', 'name', 'whatsapp', 'status', 'hp'])
        && d.keys().hasOnly(requestFields())
        && d.status == 'new'
        && d.hp == ''
        && d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.whatsapp is string && d.whatsapp.size() > 0 && d.whatsapp.size() <= 40
        && d.workshopId is string && d.workshopId.size() <= 200
        && sized(d.get('email', ''), 200)
        && sized(d.get('area', ''), 200)
        && sized(d.get('qualification', ''), 200)
        && sized(d.get('courseName', ''), 200)
        && sized(d.get('notes', ''), 200)
        && sized(d.get('paymentRef', ''), 200)
        && sized(d.get('paymentMode', ''), 200)
        && sized(d.get('dob', ''), 40)
        // An enum, not free text: a stranger writes this, so the value is
        // checked rather than merely measured. Empty is allowed — an Offline
        // or Online course never asks, and the course settles it.
        && d.get('attendMode', '') in ['', 'Offline', 'Online']
        && sized(d.get('ref', ''), 40);
    }

    match /registrationRequests/{requestId} {
      allow create: if validRequest(request.resource.data)
                    && openForRegistration(request.resource.data.workshopId);
      allow read, list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Deny everything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
